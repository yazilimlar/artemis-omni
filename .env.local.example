# Artemis Omni — environment variable template.
# Copy to .env.local for local development. NEVER commit .env.local.
# In Vercel, set these under Project → Settings → Environment Variables.
# See docs/SecurityRules.md for where each secret belongs.

# Public site URL (used for canonical URLs, OG, sitemap).
# Local:    http://localhost:3000
# Preview:  the Vercel-generated *.vercel.app URL (default way to share the prototype)
# Staging:  https://artemis.agoraxai.com — POSSIBLE FUTURE domain only; NOT assumed
#           live or configured. See docs/DeploymentPlan.md (options A/B/C).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prime ERP Flask backend origin for the /labs/prime-erp showcase (server-only,
# never NEXT_PUBLIC_*). Unset → ERP /api/* paths 404 and panels render empty.
# Read at build time by next.config.mjs rewrites — redeploy after changing.
# PRIME_ERP_BACKEND_URL=

# --- The following are placeholders for FUTURE phases. Leave unset for now. ---

# Analytics (optional, future)
# NEXT_PUBLIC_ANALYTICS_ID=

# Supabase Auth for /control and /system-map (ADR-011). No other auth/db.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated list of emails allowed to sign in. Server-only.
# ARTEMIS_INTERNAL_ALLOWLIST=you@example.com,other@example.com
# Not used by ADR-011; do not add for the auth gate.
# SUPABASE_SERVICE_ROLE_KEY=        # server-only secret, never expose to client

# Email / contact backend (future — to make the pilot form live)
# CONTACT_EMAIL_TO=
# RESEND_API_KEY=

# AI provider keys (future — server-only, never NEXT_PUBLIC_*)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
