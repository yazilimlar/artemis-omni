{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemis.agoraxai.com/schemas/atlasiq/evidence-record.schema.json",
  "title": "AtlasIQ Evidence Record",
  "type": "object",
  "required": ["record_id", "opportunity_id", "field", "value", "status", "evidence", "confidence"],
  "properties": {
    "record_id": {"type": "string"},
    "opportunity_id": {"type": "string"},
    "field": {"type": "string"},
    "value": {},
    "status": {
      "enum": ["confirmed", "derived", "inferred", "conflicted", "superseded", "missing", "human_review_required"]
    },
    "responsible_party": {"type": ["string", "null"]},
    "stage": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id"],
        "properties": {
          "document_id": {"type": "string"},
          "sha256": {"type": ["string", "null"]},
          "page": {"type": ["integer", "null"], "minimum": 1},
          "sheet": {"type": ["string", "null"]},
          "clause": {"type": ["string", "null"]},
          "quote": {"type": ["string", "null"]},
          "bounding_box": {
            "type": ["array", "null"],
            "items": {"type": "number"},
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "models": {"type": "array", "items": {"type": "string"}},
        "disagreement": {"type": "boolean"},
        "human_approved": {"type": "boolean"},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
